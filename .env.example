# Copy to .env.local. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Any Postgres URL (e.g. Neon). Leave empty locally to use PGlite.
DATABASE_URL=
